# ===================================================================
# TECVOR TECHNOLOGIES - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================

# 1. RESEND EMAIL DISPATCH (Required for live contact form emails)
# Get your free key at: https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=re_your_resend_api_key_here

# 2. EMAIL SENDER & RECIPIENT SETTINGS
# Note: For free Cloudflare subdomains, keep 'TecVor Technologies <onboarding@resend.dev>'
# When you connect a custom domain (e.g. tecvor.com) in Resend, you can change this to 'TecVor <contact@tecvor.com>'
RESEND_FROM_EMAIL=TecVor Technologies <onboarding@resend.dev>
NOTIFICATION_EMAIL=tecvortechnology@gmail.com

# 3. BACKEND API SETTINGS (Optional - for local Node.js development)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/tecvor_technologies
